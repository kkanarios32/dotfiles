#!/usr/bin/bash

declare -A PATHS
TITLES=()

TMPFILE=$(mktemp)
eval "$(opam env --switch=forest)"
cd "$FORESTDIR"

forester query all > "$TMPFILE"

while IFS= read -r -d '' title && IFS= read -r -d '' path; do
  TITLES+=("$title")
  PATHS["$title"]="$path"
done < <(jq -j '.[] | (.title + "\u0000" + .sourcePath + "\u0000")' "$TMPFILE")
rm "$TMPFILE"

SELECTED=$(printf '%s\n' "${TITLES[@]}" | dmenu -i -l 20 -p "Open Note:")
[[ -z $SELECTED ]] && exit 1

SOURCEPATH="${PATHS[$SELECTED]}"
SLUG=$(basename "$SOURCEPATH" .tree)

if ! tmux has-session -t forest 2>/dev/null; then
  "$FORESTDIR/scripts/fserve"
  until curl -s -o /dev/null "http://localhost:1234/$SLUG/index.html"; do
    sleep 0.2
  done
fi

firefox --new-window "http://localhost:1234/$SLUG/index.html"
