#!/usr/bin/env bash

function dmenuopt () {
    echo "-i -c -h 25" 
}

filter=$(echo "" | dmenu $(dmenuopt) -p "Enter filter:")

[[ -z $filter ]] && exit 1

case "$filter" in
    np)
        filter='@next & @project'
    ;;
    nt)
        filter='@next & !@project'
    ;;
    sp) 
        filter='@someday & @project'
    ;;
    st)
        filter='@someday & !@project'
    ;;
esac

cmd="todoist list -f '$filter' | tdlp | less -R"

alacritty --class Show -e zsh -c "$cmd"
