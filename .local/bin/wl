#!/usr/bin/env bash

# === CONFIG ===
PATH_TO_LOG=$PROJECTDIR/worklog
ENTRIES=4

# === STATE ===
LIST=false
ADD=false
MESSAGE=""
SEARCH=""
COLOR_DATE="\033[1;36m"  # Cyan bold
COLOR_MATCH="\033[1;33m" # Yellow bold
COLOR_TIME="\033[1;31m"
COLOR_RESET="\033[0m"

# === PARSE ARGS ===
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    list|l) LIST=true ;;
    add|a) 
      ADD=true;
      shift ;
      MESSAGE="$*";
      break
      ;;
    entries|n) ENTRIES="$2"; shift ;;
    grep|s) 
      shift
      SEARCH="$*"; 
      break
      ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
  shift
done

# === FUNCTIONS ===

print_log() {
  pushd "$PATH_TO_LOG" > /dev/null || exit 1
  prev_date=""

  for ((i=0; i<ENTRIES; i++)); do
    date_start=$(date -d "$i days ago" +%Y-%m-%d)
    date_end=$(date -d "$((i+1)) days ago" +%Y-%m-%d)

    git log --date=format:"%Y-%m-%d %H:%M:%S" --format="%ad;%s" --before="$date_start" --after="$date_end" | while IFS=';' read -r datetime msg; do
      date="${datetime%% *}"
      time="${datetime##* }"
      [[ -z "$msg" ]] && continue
      if [[ -n "$SEARCH" ]] && ! grep -iq "$SEARCH" <<< "$msg"; then
        continue
      fi

      if [[ "$prev_date" != "$date" ]]; then
        prev_date="$date"
        long_date=$(date -d "$date" "+%A, %B %d, %Y")
        echo -e "\n${COLOR_DATE}*** $long_date ***${COLOR_RESET}\n"
      fi

      # Highlight search term
      if [[ -n "$SEARCH" ]]; then
      msg=$(sed -E "s/($SEARCH)/$(printf '\033[1;33m')\1$(printf '\033[0m')/Ig" <<< "$msg")
      fi

      echo -e "${COLOR_TIME}$time${COLOR_RESET}: $msg"
    done
  done

  echo
  popd > /dev/null || exit 1
}

add_log() {
  pushd "$PATH_TO_LOG" > /dev/null || exit 1
  git commit -m "$MESSAGE" --allow-empty > /dev/null
  popd > /dev/null || exit 1
  echo "Log added."
}

# === MAIN LOGIC ===

if $LIST || [[ -z "$MESSAGE" ]]; then
  print_log
elif $ADD || [[ -n "$MESSAGE" ]]; then
  add_log
fi
