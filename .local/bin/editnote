#!/usr/bin/bash

declare -A PATHS
TITLES=()

TMPFILE=$(mktemp)
eval "$(opam env --switch=forest)"
cd "$FORESTDIR"

forester query all > "$TMPFILE"

while IFS= read -r -d '' title && IFS= read -r -d '' path; do
  TITLES+=("$title")
  PATHS["$title"]="$path"
done < <(jq -j '.[] | (.title + "\u0000" + .sourcePath + "\u0000")' "$TMPFILE")
rm "$TMPFILE"

SELECTED=$(printf '%s\n' "${TITLES[@]}" | dmenu -i -l 20 -p "Edit Note:")
[[ -z $SELECTED ]] && exit 1

SOURCEPATH="${PATHS[$SELECTED]}"

# Launch Alacritty with nvim on selected file
alacritty -e bash -c "eval \"\$(opam env --switch=forest)\"; nvim \"$SOURCEPATH\""
