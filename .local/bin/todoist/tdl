#!/usr/bin/env bash

function dmenuopt () {
    echo "-i -c -h 25" 
}

filter=$(echo "" | dmenu $(dmenuopt) -p "Enter filter:")

[[ -z $filter ]] && exit 1

case "$filter" in
    rc)
        filter='##Research & @next & @coding'
    ;;
    rr)
        filter='##Research & @next & !@coding'
    ;;
    pc)
        filter='##Personal & @next & @coding'
    ;;
    ssn)
        filter='##Selfstudy & @next'
    ;;
    ln) 
        filter='##Learning & @next'
    ;;
    rs)
        filter='##Research & @someday'
    ;;
    ps)
        filter='##Personal & @someday'
    ;;
    ls)
        filter='##Learning & @someday'
    ;;
esac

cmd="todoist --indent list -f '$filter' | tdlpy | less -R"
echo $cmd

alacritty -e zsh -c "$cmd"
