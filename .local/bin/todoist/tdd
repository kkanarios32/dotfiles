#!/usr/bin/env python3
"""tdd — todoist filter menus.

Drives dmenu pickers off saved Todoist filters (Next, Backlog), grouped by
top-level project. Talks to Todoist via the `todoist` CLI; the project
hierarchy is read from the CLI's local sync cache.
"""

import csv
import io
import json
import os
import subprocess
import sys
from pathlib import Path

# Saved Todoist filters, replicated as filter expressions for the CLI.
NEXT_FILTER = "(p1 & (##Study | ##Work)) | today"
BACKLOG_FILTER = "p2 & (##Study | ##Work)"
CACHE_FILE = Path(os.path.expanduser("~/.cache/todoist/cache.json"))


def dmenu(items, prompt):
    """items: list of (display, key). Returns the selected key, or None."""
    args = ["dmenu", "-i", "-c", "-l", "15", "-h", "32", "-p", prompt]
    # A leading \x01 tags a dimmed row; dmenu strips it before display and
    # before echoing the selection, so key the lookup by the stripped text.
    display_to_key = {disp.lstrip("\x01"): key for disp, key in items}
    input_data = "\n".join(disp for disp, _ in items)
    try:
        result = subprocess.run(args, input=input_data, capture_output=True, text=True)
    except FileNotFoundError:
        sys.stderr.write("dmenu not installed.\n")
        sys.exit(1)
    if result.returncode != 0:
        return None
    choice = result.stdout.rstrip("\n")  # keep leading marker spaces intact
    return display_to_key.get(choice)


def list_filter_tasks(filter_expr):
    """Tasks matching a filter expression, as [{id, project, content}, ...]."""
    r = subprocess.run(["todoist", "--csv", "list", "--filter", filter_expr],
                       capture_output=True, text=True)
    tasks = []
    for row in csv.reader(io.StringIO(r.stdout)):
        if len(row) < 6:
            continue
        tid, _pri, _due, proj, _lbl, content = row[:6]
        tasks.append({"id": tid, "project": proj, "content": content})
    return tasks


def task_root_projects():
    """Map todoist item id -> top-level (root ancestor) project name, from cache."""
    if not CACHE_FILE.exists():
        return {}
    cache = json.loads(CACHE_FILE.read_text(encoding="utf-8"))
    projs = {p["id"]: p for p in cache.get("projects", [])}

    def root(pid):
        p = projs.get(pid)
        while p and p.get("parent_id") and projs.get(p["parent_id"]):
            p = projs[p["parent_id"]]
        return p["name"] if p else None

    return {str(it["id"]): root(it.get("project_id")) for it in cache.get("items", [])}


def group_tasks(filter_expr):
    """Filter tasks grouped by top-level project: [(root, [task, ...]), ...]."""
    roots = task_root_projects()
    groups = {}
    for t in list_filter_tasks(filter_expr):
        root = roots.get(t["id"]) or t["project"].lstrip("#").split("/")[0]
        groups.setdefault(root, []).append(t)
    return sorted(groups.items())


def grouped_dmenu_items(groups):
    """Flatten grouped tasks into dmenu rows + an id->content map.

    Dimmed project headers (\\x01) sit above the actionable task rows.
    """
    items, content_map = [], {}
    for gi, (root, ts) in enumerate(groups):
        items.append((f"\x01{root}", f"__hdr__{gi}"))
        for t in ts:
            items.append((f"  ○  {t['content']}", t["id"]))
            content_map[t["id"]] = t["content"]
    return items, content_map


def complete_task(tid, content):
    """Close a task in todoist and refresh the local cache."""
    r = subprocess.run(["todoist", "c", tid], capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(f"  ! todoist failed for {content}: {r.stderr.strip()}\n")
        return
    subprocess.run(["todoist", "sync"], capture_output=True, text=True)
    print(f"  ✓ {content}")


def promote_to_p1(tid, content):
    """Bump a task to p1 so it surfaces in the Next filter."""
    r = subprocess.run(["todoist", "modify", "-p", "1", tid],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(f"  ! todoist failed for {content}: {r.stderr.strip()}\n")
        return False
    print(f"  ↑ p1  {content}")
    return True


def cmd_next(count=False, as_list=False):
    groups = group_tasks(NEXT_FILTER)
    total = sum(len(ts) for _, ts in groups)
    if count:
        print(total)
        return
    if as_list:
        # Machine-readable dump for other tools (e.g. the `daily` note seeds
        # itself with these): one task per line, tab-separated as
        # <root-project>\t<content>, in the same grouped order as the dmenu.
        for root, ts in groups:
            for t in ts:
                print(f"{root}\t{t['content']}")
        return
    if not groups:
        return
    items, content_map = grouped_dmenu_items(groups)
    key = dmenu(items, f"Next  {total} ")
    if not key or key.startswith("__hdr__"):
        return
    complete_task(key, content_map[key])


def cmd_backlog(count=False):
    groups = group_tasks(BACKLOG_FILTER)
    total = sum(len(ts) for _, ts in groups)
    if count:
        print(total)
        return
    if not groups:
        return
    # Loop so several tasks can be promoted in one sitting; each pick drops out
    # of the menu. Escape (or selecting a header) ends the session.
    promoted = set()
    while True:
        live = [(root, [t for t in ts if t["id"] not in promoted])
                for root, ts in groups]
        live = [(root, ts) for root, ts in live if ts]
        if not live:
            break
        left = sum(len(ts) for _, ts in live)
        items, content_map = grouped_dmenu_items(live)
        key = dmenu(items, f"Promote to Next  {left} ")
        if not key or key.startswith("__hdr__"):
            break
        if promote_to_p1(key, content_map[key]):
            promoted.add(key)
    if promoted:
        subprocess.run(["todoist", "sync"], capture_output=True, text=True)


USAGE = """tdd — todoist filter menus

USAGE:
  tdd next             dmenu of the Next filter, grouped by top-level project;
                       pick a task to close it (synced to todoist)
  tdd next count       print the number of Next-filter tasks (for sb-todo)
  tdd next list        print the Next-filter tasks as <project>\t<content>
                       lines (for the daily note); no dmenu
  tdd backlog          dmenu of the Backlog filter, grouped by top-level
                       project; pick tasks to promote to p1 (into Next)
  tdd backlog count    print the number of Backlog-filter tasks
  tdd help             show this help"""


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "next"
    rest = args[1:]
    if cmd == "next":
        cmd_next(count=any(a == "count" for a in rest),
                 as_list=any(a == "list" for a in rest))
    elif cmd == "backlog":
        cmd_backlog(count=any(a == "count" for a in rest))
    elif cmd in ("help", "-h", "--help"):
        print(USAGE)
    else:
        sys.stderr.write(USAGE + "\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
