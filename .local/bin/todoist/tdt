#!/usr/bin/bash

function dmenuopt () { echo "-i -c -h 25" 
}

function labels () {
    # Get list of projects as "ID #Name"
    labels=$(todoist labels)
    labels=$(echo "$labels" | sed -E 's/.*@//')
    selected_labels=$(echo "$labels" | dmenu $(dmenuopt) -l 10 -p "Select labels:")
    [ -z "$selected_labels" ] && exit 1

    labels=$(echo $selected_labels | sed -E 's/ /\,/g')
    echo "$labels"
}

function priority () {
    priority=$(dmenu $(dmenuopt) -p "Priority (1-4):")
    [ -z "$priority" ] && exit 1

    echo "$priority"
}

kind=$(printf "Subtask\nTask" | dmenu $(dmenuopt) -l 2 -p "What do you want to add?")

[ -z "$kind" ] && exit 1

TMPFILE=$(mktemp)
alacritty --class Show -e nvim +2 "${TMPFILE}"
item_name=$(cat ${TMPFILE})

[ -z "$item_name" ] && exit 1

# Find the ID corresponding to the selected name
if [[ "$kind" = "Subtask" ]]; then 
    # Get full task lines (ID, metadata, content)
    tasks=$(todoist list)  # Or your custom task-generating command
    # Use newline splitting only
    IFS=$'\n' read -d '' -r -a lines <<< "$tasks"

    # Build parallel arrays: task_names and full_lines
    task_names=()
    for line in "${lines[@]}"; do
        # Task name: remove everything up to and including the last tag/marker
        # We'll conservatively strip everything before the last occurrence of '@' or '#' or priority
        name=$(echo "$line" | sed -E 's/^.*([@#][^[:space:]]+[[:space:]]+)+//')
        task_names+=("$name")
    done

    # Show just the task names in dmenu
    selected_name=$(printf "%s\n" "${task_names[@]}" | dmenu $(dmenuopt) -l 10 -p "Select a task:")

    # Exit if cancelled
    [ -z "$selected_name" ] && exit 1

    # Find the corresponding full line
    selected_line=""
    for i in "${!task_names[@]}"; do
        if [[ "${task_names[$i]}" == "$selected_name" ]]; then
            selected_line="${lines[$i]}"
            break
        fi
    done

    # Extract the task ID (first field)
    task_id=$(echo "$selected_line" | awk '{print $1}')

    todoist a -I "$task_id" -p "$(priority)" "$item_name"
else
    # Get list of projects as "ID #Name"
    project_lines=$(todoist projects)

    # Extract display names and build a lookup table
    menu_entries=$(echo "$project_lines" | sed -E 's/^[0-9]+ #[ ]?//')

    # Prompt user to select project from names
    selected_name=$(echo "$menu_entries" | dmenu $(dmenuopt) -l 10 -p "Select parent project:")

    # Exit if nothing selected
    [ -z "$selected_name" ] && exit 1
    todoist a -N "$selected_name" -p "$(priority)" "$item_name" 
fi

rm $TMPFILE
