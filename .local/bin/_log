#!/usr/bin/bash

# Opens the default log file with vim. Accepts the
# standard `date` offset. Prompts to commit.
PROJECTDIR=$HOME/Projects

relpath=$(datepath "$*")
dir="${PROJECTDIR}/inbox/$relpath"
file="$dir/daily.md"
mkdir -p "${dir}"

# prepend a timestamped heading

tmpfile=$(mktemp)
echo "## $(now)" >"${tmpfile}"
echo -e "\n\n" >>"${tmpfile}"
if [ -e "${file}" ]; then
  cat "${file}" >>"${tmpfile}"
fi
mv "${tmpfile}" "${file}"

echo "${file}"
nvim +3 "${file}"

read -p 'Do you want to commit? ' commit

if [[ ! $commit =~ ^[Yy] ]]; then
  exit
fi

cd "${dir}"
git add "${file}"
git commit
git push
