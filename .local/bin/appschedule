#!/usr/bin/bash

    if [ $# -ne 1 ]; then
        echo "Usage: $(basename "$0") APP_NAME"
        exit 1
    fi

    export DISPLAY=:0

    app_name="$1"

    # Blocked usage time window (24-hour format)
    START_TIME="09:00"
    END_TIME="13:00"

    # Keywords for allowed URLs in the title
    ALLOWED_KEYWORDS=("kellenkanarios" "github" "wandb" "localhost" "calendar" "CS336")

    # Convert to seconds since midnight
    start_seconds=$((10#${START_TIME%%:*} * 3600 + 10#${START_TIME##*:} * 60))
    end_seconds=$((10#${END_TIME%%:*} * 3600 + 10#${END_TIME##*:} * 60))

    get_current_seconds() {
        now=$(date +%H:%M)
        echo $((10#${now%%:*} * 3600 + 10#${now##*:} * 60))
    }

    check_allowed_title() {
        local title="$1"
        for keyword in "${ALLOWED_KEYWORDS[@]}"; do
            if [[ "$title" == *"$keyword"* ]]; then
                return 0
            fi
        done
        return 1
    }

    while : ; do
        pid=$(pgrep -x "$app_name")
        sleep 1
        if [ "$pid" != "" ]; then
            now_seconds=$(get_current_seconds)
            if (( now_seconds >= start_seconds && now_seconds < end_seconds ));
  then
                windows=$(wmctrl -lp | grep "$pid")
                wmctrl -lp | grep "$pid" | while read -r line; do
                    window_id=$(echo "$line" | awk '{print $1}')
                    echo $window_id
                    window_title=$(echo "$line" | sed 's/^[^ ]* [^ ]* [^ ]* //')

                    if [ "$window_title" != "" ]; then
                        if check_allowed_title "$window_title"; then
                            sleep 1
                        else
                            dunstify "Disallowed window, closing: $window_title"
                            xdotool windowclose "$window_id"
                        fi
                    fi
                done
            else
                sleep 60  # Allow it for a minute before checking again
            fi
        fi
    done
