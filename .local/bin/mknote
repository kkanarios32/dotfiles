#!/bin/bash
# mknote — create a forest note in the right pipeline stage and open it.
#
# Thin wrapper around $FORESTDIR/scripts/new, which is the single source of
# truth for frontmatter, tagging, and the notes-log.md / inbox.md refresh.
# The directory IS the pipeline stage:
#
#   def / note / thm / prop / blog / ...  -> trees/evergreen/ (evergreen note)
#   transient                             -> trees/inbox/     (transient; @citekey)
#   stub                                  -> trees/stubs/     (concept stub / link target)
#
# Usage:
#   mknote <type> <title...> [@citekey]     e.g. mknote transient Store buffer @henn2017
#   mknote                                   dmenu: pick a type, then type a title
#                                            (append @citekey when making a transient note)

# Types offered in the dmenu picker.
TYPES=$'def\nnote\ntransient\nstub\nblog'

_run() {
  local type="$1"; shift
  local title="$*"

  cd "$FORESTDIR" || exit 1
  eval "$(opam env --switch=forest)"

  # Delegate to scripts/new. It prints the new file path on the first line,
  # then the registry/inbox refresh messages — capture all of it so those
  # steps run to completion, then peel off the path.
  local out filepath
  out=$("$FORESTDIR/scripts/new" "$type" $title) || { echo "$out" >&2; exit 1; }
  filepath=$(printf '%s\n' "$out" | head -n1)

  [ -n "$filepath" ] && [ -e "$filepath" ] && nvim + "$filepath"
}

if [[ $# -ge 2 ]]; then
  _run "$@"
  exit
fi

TYPE=$(printf '%s\n' "$TYPES" | dmenu -i -l 5 -p "Type:")
[[ -z "$TYPE" ]] && exit 0
TITLE=$(dmenu -i -l 20 -p "Title:" < /dev/null)
[[ -z "$TITLE" ]] && exit 0

cmd="$(declare -f _run); _run \"$TYPE\" \"$TITLE\""
alacritty -e bash -l -c "$cmd"
