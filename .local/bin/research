#!/usr/bin/bash

_log() {
  cd "$FORESTDIR" || exit 1
  eval "$(opam env --switch=forest)"

  notebook_name="$1"
  research_root="${FORESTDIR}/trees/research"
  notebook_dir="${research_root}/${notebook_name}"
  notebook_index="${notebook_dir}/${notebook_name}.tree"

  datetag=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  if [ ! -d "${notebook_dir}" ]; then
    mkdir -p "${notebook_dir}"
    cat > "${notebook_index}" <<NOTEBOOKEOF
\\import{base-macros}
\\author{kellenkanarios}
\\meta{author}{false}
\\tag{private}
\\title{Research Notebook: ${notebook_name}}
\\date{${datetag}}
NOTEBOOKEOF
    nvim + "${notebook_index}"
  else
    date_slug=$(datefile)
    daily_file="${notebook_dir}/${notebook_name}-${date_slug}.tree"

    if [ ! -e "${daily_file}" ]; then
      cat > "${daily_file}" <<DAILYEOF
\\import{base-macros}
\\author{kellenkanarios}
\\meta{author}{false}
\\tag{private}
\\title{[${notebook_name}](${notebook_name}) - [${date_slug}](${date_slug})}
\\date{${datetag}}

\\p{\\strong{Did today:}}
\\ul{

}
\\p{\\strong{Stopped at:}}
\\ul{

}
\\p{\\strong{Next step:}}
\\ul{

}
\\p{\\strong{Open Questions:}}
\\ul{

}
DAILYEOF
    fi
    nvim + "${daily_file}"
  fi

  read -p 'Do you want to commit? ' commit

  if [[ ! $commit =~ ^[Yy] ]]; then
    exit
  fi

  cd "${research_root}" || exit 1
  git add -A "${notebook_dir}"
  git commit
  git push
}

research_root="${FORESTDIR}/trees/research"
mkdir -p "${research_root}"

existing=$(find "${research_root}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
notebook_name=$(printf '%s\n' "${existing}" | dmenu -i -l 20 -p "Notebook:")
[[ -z $notebook_name ]] && exit 1

if ! tty >/dev/null 2>&1; then
  command="$(declare -f _log; echo "_log \"${notebook_name}\"")"
  alacritty -e bash -l -c "$command"
else
  _log "${notebook_name}"
fi
