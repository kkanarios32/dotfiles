#!/usr/bin/bash

declare -A PATHS
TITLES=()

TMPFILE=$(mktemp)
eval "$(opam env --switch=forest)"
cd "$FORESTDIR"

forester query all > "$TMPFILE"

while IFS= read -r -d '' title && IFS= read -r -d '' path; do
  TITLES+=("$title")
  PATHS["$title"]="$path"
done < <(jq -j '.[] | select((.tags? // []) | index("todo")) | (.title + "\u0000" + .sourcePath + "\u0000")' "$TMPFILE")
rm "$TMPFILE"

[[ ${#TITLES[@]} -eq 0 ]] && exit 0

SELECTED=$(printf '%s\n' "${TITLES[@]}" | dmenu -i -l 20 -p "Open Todo:")
[[ -z $SELECTED ]] && exit 1

SOURCEPATH="${PATHS[$SELECTED]}"

alacritty -e bash -c "eval \"\$(opam env --switch=forest)\"; nvim \"$SOURCEPATH\""
