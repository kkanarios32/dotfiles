#!/usr/bin/python3

import sys
import subprocess
import re


# ANSI color codes (some bright system colors)
class Colors:
    RESET = "\033[0m"
    BRIGHT_BLUE = "\033[94m"
    BRIGHT_GREEN = "\033[92m"
    BRIGHT_CYAN = "\033[96m"
    BRIGHT_MAGENTA = "\033[95m"
    BRIGHT_YELLOW = "\033[93m"
    BRIGHT_RED = "\033[91m"
    BRIGHT_WHITE = "\033[97m"
    BRIGHT_BLACK = "\033[90m"


ansi_escape = re.compile(r"\x1B\[[0-?]*[ -/]*[@-~]")


def run_todoist_command():
    result = subprocess.run(
        ["todoist", "list", "-f", "@next"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        print("Error running todoist command:")
        print(result.stderr)
        exit(1)
    return result.stdout


def strip_ansi(text):
    return ansi_escape.sub("", text)


def parse_lines(lines):
    project_map = {}

    for line in lines:
        clean_line = strip_ansi(line)
        clean_parts = clean_line.strip().split()

        if len(clean_parts) < 4:
            continue

        task_id = clean_parts[0]

        try:
            project_idx = next(
                i for i, part in enumerate(clean_parts) if part.startswith("#")
            )
            clean_project = clean_parts[project_idx]
        except StopIteration:
            clean_project = "NoProject"

        clean_parts.pop(project_idx)

        context_indices = [i for i, p in enumerate(clean_parts) if p.startswith("@")]
        contexts = [clean_parts[i] for i in context_indices]

        last_ctx_idx = context_indices[-1] if context_indices else 3
        description = " ".join(clean_parts[last_ctx_idx + 1 :])

        if clean_project not in project_map:
            project_map[clean_project] = []

        project_map[clean_project].append((task_id, contexts, description))

    return project_map


def colorize(text, color_code):
    return f"{color_code}{text}{Colors.RESET}"


def display_tasks_colored(project_map):
    # Define a palette of colors to cycle through
    project_colors = [
        Colors.BRIGHT_BLUE,
        Colors.BRIGHT_GREEN,
        Colors.BRIGHT_CYAN,
        Colors.BRIGHT_MAGENTA,
        Colors.BRIGHT_YELLOW,
        Colors.BRIGHT_RED,
        Colors.BRIGHT_WHITE,
        Colors.BRIGHT_BLACK,
    ]

    ctx_color = Colors.BRIGHT_CYAN
    id_color = Colors.BRIGHT_BLACK

    projects = sorted(project_map.keys())
    for idx, project in enumerate(projects):
        color = project_colors[idx % len(project_colors)]
        print(colorize(project + ":", color))
        for task_id, contexts, description in project_map[project]:
            ctx_str = ", ".join([colorize(ctx, ctx_color) for ctx in contexts])
            print(f"  {colorize(task_id, id_color)} ({ctx_str}) {description}")


def main():
    # raw_output = run_todoist_command()
    # lines = raw_output.strip().split("\n")
    lines = [line.rstrip("\n") for line in sys.stdin]
    project_map = parse_lines(lines)
    display_tasks_colored(project_map)


if __name__ == "__main__":
    main()
