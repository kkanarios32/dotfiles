#!/bin/bash

_create() {
  cd "$FORESTDIR" || exit 1
  eval "$(opam env --switch=forest)"

  dir="${FORESTDIR}/trees/fleet"
  mkdir -p "${dir}"

  index="${dir}/fleet.tree"
  if [ ! -e "${index}" ]; then
    cat > "${index}" <<INDEXEOF
\\import{base-macros}
\\title{Fleeting notes}
\\author{kellenkanarios}

INDEXEOF
  fi

  TITLE="$*"
  FILEPATH=$(opam exec -- forester new --random --dest="${dir}")
  ID=$(basename "${FILEPATH}" .tree)
  datetag=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  cat > "${FILEPATH}" <<FLEETEOF
\\import{base-macros}
\\author{kellenkanarios}
\\meta{author}{false}
\\tag{private}
\\title{${TITLE}}
\\date{${datetag}}

FLEETEOF

  echo "\\transclude{${ID}}" >> "${index}"
  echo "${FILEPATH}"
}

_edit() {
  FILEPATH=$(_create "$@")
  nvim + "${FILEPATH}"
}

if ! tty >/dev/null 2>&1; then
  NAME=$(dmenu -i -l 20 -p "Fleet:")
  [ -z "$NAME" ] && exit 0
  command="$(declare -f _create; declare -f _edit; echo "_edit \"$NAME\"")"
  alacritty -e bash -l -c "$command"
else
  _edit "$@"
fi
