#!/usr/bin/python3

import os
import tempfile
import subprocess

TARGET = "image/x-inkscape-svg"


def open_editor(filename):
    subprocess.run(
        [
            "alacritty",
            "--class",
            "Show",
            "-e",
            "nvim",
            "+2",
            f"{filename}",
        ]
    )


def latex_document(latex):
    return (
        r"""
        \documentclass[12pt,border=12pt]{standalone}

        \usepackage[utf8]{inputenc}
        \usepackage[T1]{fontenc}
        \usepackage{textcomp}
        \usepackage{amsmath, amssymb}
        \newcommand{\R}{\mathbb R}

        \begin{document}
    """
        + latex
        + r"\end{document}"
    )


def compile_latex_to_svg(latex_file):
    workdir = tempfile.gettempdir()

    # Run pdflatex quietly
    subprocess.run(
        ["pdflatex", "-interaction=nonstopmode", latex_file],
        cwd=workdir,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    pdf_file = latex_file.replace(".tex", ".pdf")
    svg_file = latex_file.replace(".tex", ".svg")

    # Convert pdf to svg
    result = subprocess.run(["pdf2svg", pdf_file, svg_file], cwd=workdir)
    if result.returncode != 0:
        print("Error:", result.stderr.decode())

    return os.path.join(workdir, svg_file)


def copy_svg_to_clipboard(svg_path):
    with open(svg_path, "rb") as f:
        result = subprocess.run(
            ["xclip", "-selection", "clipboard", "-t", TARGET], stdin=f
        )
        if result.returncode != 0:
            print("Error:", result.stderr.decode())


def main():
    # Create temp tex file with a minimal document
    with tempfile.NamedTemporaryFile(mode="w+", suffix=".tex", delete=False) as tf:
        tf.flush()
        tex_path = tf.name

        tf.write("$$\n\n$$")
        tf.close()
        # Open Vim to edit
        open_editor(tex_path)
        with open(tex_path, "r") as g:
            latex = g.read().strip()

    with tempfile.NamedTemporaryFile(mode="w+", suffix=".tex", delete=False) as tf:
        tf.flush()
        tf.write(latex_document(latex))
        tex_path = tf.name

    # Compile and get svg
    svg_path = compile_latex_to_svg(tex_path)

    # Copy svg to clipboard
    copy_svg_to_clipboard(svg_path)

    print("SVG copied to clipboard! You can paste it into Inkscape now.")

    # Cleanup temp files
    for ext in [".aux", ".log", ".pdf", ".tex", ".svg"]:
        try:
            os.remove(tex_path.replace(".tex", ext))
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    main()
