#!/usr/bin/bash

# Prompt for a search query using dmenu
query=$(dmenu -p "cppref:" <&-)

# Exit if input is empty or cancelled
[ -z "$query" ] && exit

# URL-encode the query (spaces, +, &, etc.)
encoded=$(printf '%s' "$query" | jq -sRr @uri)

# MediaWiki "go" search: jumps straight to an exact page match,
# otherwise falls back to cppreference's search results.
exec xdg-open "https://www.cppreference.com/mwiki/index.php?title=Special:Search&go=Go&search=$encoded"
