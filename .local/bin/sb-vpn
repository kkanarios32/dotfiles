#!/usr/bin/zsh

IFACE=$(ip addr | grep cscotun | awk -F': ' '{print $2}')

if [[ "$IFACE" = cscotun* ]]; then
    # echo "^c#A3BE8C^󰕥 $(ip addr show cscotun0 | grep inet | awk '{print $2}' | cut -f2 -d ':')^c#FFFFFF^"
    echo "^c#A3BE8C^󰕥$(ip addr show cscotun0 | grep inet | awk '{print $2}' | cut -f2 -d ':')^c#FFFFFF^"
else
    echo "^c#BF616A^󰫜^c#FFFFFF^"
fi
