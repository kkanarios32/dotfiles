#!/bin/bash

_log() {
  cd "$FORESTDIR" || exit 1
  eval "$(opam env --switch=forest)"

  dir="${FORESTDIR}/trees/daily"
  filename=$(datefile "$*")
  file="$dir/${filename}.tree"
  mkdir -p "${dir}"
  mkdir -p "${FORESTDIR}/data"

  passages_file="${FORESTDIR}/data/meditations_passages.json"
  read_file="${FORESTDIR}/data/read.json"

  datetag=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  # Try to pull yesterday's "Tomorrow's Todos" into today's "Today's Todos"
  yesterday_file="$dir/$(datefile yesterday).tree"
  carried_todos="$(
    python3 - <<PY
from pathlib import Path

yesterday_file = Path(r"""${yesterday_file}""")

if not yesterday_file.exists():
    print("")
    raise SystemExit(0)

text = yesterday_file.read_text(encoding="utf-8")

marker = r"\section{Tomorrow's Todos}{"
start = text.find(marker)

if start == -1:
    print("")
    raise SystemExit(0)

i = start + len(marker)
depth = 1
content = []

while i < len(text) and depth > 0:
    c = text[i]

    if c == "{":
        depth += 1
    elif c == "}":
        depth -= 1
        if depth == 0:
            break

    content.append(c)
    i += 1

result = "".join(content)
if result.startswith("\n"):
    result = result[1:]
print(result.rstrip())
PY
)"

  research_root="${FORESTDIR}/trees/research"
  research_transcludes=""
  research_files_to_add=()

  if [ ! -e "${file}" ] && [ -d "${research_root}" ]; then
    while IFS= read -r notebook_name; do
      [[ -z "$notebook_name" ]] && continue
      notebook_dir="${research_root}/${notebook_name}"
      notebook_index="${notebook_dir}/${notebook_name}.tree"
      [ ! -e "${notebook_index}" ] && continue

      date_slug=$(datefile)
      daily_filename="${notebook_name}-${date_slug}"
      daily_file="${notebook_dir}/${daily_filename}.tree"

      if [ ! -e "${daily_file}" ]; then
        cat > "${daily_file}" <<NBDAILYEOF
\\import{base-macros}
\\author{kellenkanarios}
\\meta{author}{false}
\\tag{private}
\\title{[${notebook_name}](${notebook_name}) - $(now)}
\\date{${datetag}}

\\p{\\strong{Did today:}}
\\ul{

}
\\p{\\strong{Stopped at:}}
\\ul{

}
\\p{\\strong{Next step:}}
\\ul{

}
\\p{\\strong{Open Questions:}}
\\ul{

}
NBDAILYEOF
        echo "\\transclude{${daily_filename}}" >> "${notebook_index}"
        research_files_to_add+=("${daily_file}" "${notebook_index}")
      fi

      research_transcludes+="\\transclude{${daily_filename}}"$'\n'
    done < <(find "${research_root}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
  fi

  if [ ! -e "${file}" ]; then
      quote="$(python3 - <<PY
import json
import random
from pathlib import Path

passages_file = Path(r"""${passages_file}""")
read_file = Path(r"""${read_file}""")

if not passages_file.exists():
    print("Meditations passages file not found.")
    raise SystemExit(0)

with passages_file.open(encoding="utf-8") as f:
    passages = json.load(f)

if read_file.exists():
    with read_file.open(encoding="utf-8") as f:
        read = set(json.load(f))
else:
    read = set()

unread = [p for p in passages if p["id"] not in read]

if not unread:
    print("You have read all passages.")
    raise SystemExit(0)

today = random.choice(unread)

text = today["text"].replace("\\\\", "\\\\\\\\")
print("\\\\iblock{")
print(f"\\\\strong{{Book {today['book']}, Section {today['section']}}}")
print(f"\\\\em{{{text}}}")
print("}")

read.add(today["id"])
with read_file.open("w", encoding="utf-8") as f:
    json.dump(sorted(read), f, indent=2)
PY
)"
    cat > "${file}" <<DAILYEOF
\\import{base-macros}
\\author{kellenkanarios}
\\meta{author}{false}
\\tag{private}
\\title{$(now)}
\\date{${datetag}}

\\section{Daily Meditations}{
${quote}
\\p{\\strong{Translation:}}
}

\\section{Today's Todos}{
${carried_todos}
}

\\section{Research}{
${research_transcludes}}

\\section{Tomorrow's Todos}{

}
DAILYEOF

    echo "\\transclude{${filename}}" >> "${dir}/daily.tree"
    nvim +12 "${file}"
  else
    nvim + "${file}"
  fi

  read -p 'Do you want to commit? ' commit

  if [[ ! $commit =~ ^[Yy] ]]; then
    exit
  fi

  cd "${dir}" || exit 1
  git add "${file}"
  if [ ${#research_files_to_add[@]} -gt 0 ]; then
    git add "${research_files_to_add[@]}"
  fi
  git commit
  git push
}

if ! tty >/dev/null 2>&1; then
  command="$(declare -f _log; echo "_log")"
  alacritty -e bash -l -c "$command"
else
  _log
fi
