#!/bin/bash

_log() {
  cd "$FORESTDIR" || exit 1
  eval "$(opam env --switch=forest)"

  dir="${FORESTDIR}/trees/daily"
  filename=$(datefile "$*")
  file="$dir/${filename}.tree"
  mkdir -p "${dir}"

  datetag=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  if [ ! -e "${file}" ]; then
      # Quote of the day: a short unread passage from Marcus Aurelius'
      # Meditations, rendered as a Forester \iblock and marked read so it
      # won't recur. Empty (silently omitted) if the corpus is exhausted.
      quote="$(python3 "${FORESTDIR}/data/quote_of_the_day.py" 2>/dev/null)"

      # First call of the day: seed the note with today's todos — the same
      # "Next" filter sb-todo shows (`tdd next`) — pulled fresh from Todoist
      # and rendered as a nested outline: one bold project per top-level item,
      # its tasks nested beneath.
      todoist sync >/dev/null 2>&1 || true
      todos="$(tdd next list 2>/dev/null | awk -F'\t' '
        function esc(s){ gsub(/\\/,"/",s); gsub(/\{/,"(",s); gsub(/\}/,")",s); return s }
        NR==1 { print "\\ul{" }
        { root=esc($1); content=esc($2)
          if (root != cur) {
            if (cur != "") { print "    }"; print "  }" }
            print "  \\li{\\strong{" root "}"
            print "    \\ul{"
            cur=root
          }
          print "      \\li{" content "}"
        }
        END { if (NR>0) { print "    }"; print "  }"; print "}" } }
      ')"
      [ -z "$todos" ] && todos='\p{Nothing queued for today. 🎉}'

      cat > "${file}" <<DAILYEOF
\\import{base-macros}
\\author{kellenkanarios}
\\meta{author}{false}
\\tag{private}
\\title{$(now)}
\\date{${datetag}}

${quote}

\\section{Todos}{
${todos}
}
DAILYEOF

      echo "\\transclude{${filename}}" >> "${dir}/daily.tree"
  fi

  # Every call opens a fresh entry: the local time in bold, underlined by an
  # \hr, delimiting each sitting in the day's log.
  printf '\n\\p{\\strong{%s}}\n\\hr\n\n' "$(date +'%-I:%M %p')" >> "${file}"

  nvim + "${file}"

  read -p 'Do you want to commit? ' commit

  if [[ ! $commit =~ ^[Yy] ]]; then
    exit
  fi

  cd "${dir}" || exit 1
  git add "${file}"
  git commit
  git push
}

if ! tty >/dev/null 2>&1; then
  command="$(declare -f _log; echo "_log")"
  alacritty -e bash -l -c "$command"
else
  _log
fi
