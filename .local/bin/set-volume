#!/bin/bash

# Adjust volume: pass "up", "down", or "toggle" as $1
case "$1" in
    up)
        pactl set-sink-volume @DEFAULT_SINK@ +5%
        ;;
    down)
        pactl set-sink-volume @DEFAULT_SINK@ -5%
        ;;
    toggle)
        pactl set-sink-mute @DEFAULT_SINK@ toggle
        ;;
esac

# Get current volume and mute status
VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+%' | head -1 | tr -d '%')
MUTE=$(pactl get-sink-mute @DEFAULT_SINK@ | grep -o 'yes\|no' | head -1)

# Build a simple progress bar (10 blocks)
FILLED=$((VOL / 10))
EMPTY=$((10 - FILLED))
BAR=$(printf "█%.0s" $(seq 1 $FILLED))
BAR+=$(printf "░%.0s" $(seq 1 $EMPTY))

# Show dunst notification
if [ "$MUTE" = "yes" ]; then
    dunstify -h string:x-canonical-private-synchronous:volume "Volume: Muted" -u low
else
    dunstify -h string:x-canonical-private-synchronous:volume "Volume: [$BAR] $VOL%" -u low
fi
