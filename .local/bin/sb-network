#!/bin/zsh

case "$BUTTON" in
    1) click-network ;;
esac



COLOR="#a3be8c"

# Detect Ethernet interface (change eth0 if needed)
ETH_IFACE="enp2s0"
ETH_STATE=$(cat /sys/class/net/$ETH_IFACE/operstate 2>/dev/null)

if [ "$ETH_STATE" = "up" ]; then
    # Ethernet is connected
    QUALITY="󰈀"  # Wired network icon
else
    # Get the signal strength from 'station <device> show'
    RSSI=$(iwctl station wlan0 show | grep 'AverageRSSI' | sed -E 's/.* (-[0-9]+) dBm/\1/')

    RSSI_NUM=$(echo "$RSSI" | sed 's/[^0-9\-]//g')
    # Classify signal strength
    if [ "$RSSI_NUM" -ge -50 ]; then
        QUALITY="󰤨"
    elif [ "$RSSI_NUM" -ge -60 ]; then
        QUALITY="󰤥"
    elif [ "$RSSI_NUM" -ge -70 ]; then
        QUALITY="󰤢"
        COLOR="#ebcb8b"
    else
        QUALITY="󰤟"
        COLOR="#bf616a"
    fi
fi

echo "^c$COLOR^${QUALITY}^c#FFFFFF^"
