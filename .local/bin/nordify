#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "image-go-nord",
# ]
# ///

from ImageGoNord import NordPaletteFile, GoNord
import argparse
import os

home = os.environ.get("HOME")
default_path = os.path.join(home, "Pictures")
parser = argparse.ArgumentParser(description="Nordify images")
parser.add_argument("image_name", help="Name of image to nordify", type=str)
parser.add_argument("--image_dir", type=str, default=default_path)
args = parser.parse_args()
# E.g. Replace pixel by pixel
go_nord = GoNord()
image = go_nord.open_image(os.path.join(args.image_dir,args.image_name))
save_path = os.path.join(args.image_dir, "nord-" + args.image_name)

go_nord.enable_avg_algorithm()
# go_nord.enable_gaussian_blur()

go_nord.reset_palette()
go_nord.add_file_to_palette(NordPaletteFile.POLAR_NIGHT)
go_nord.add_file_to_palette(NordPaletteFile.SNOW_STORM)
go_nord.add_file_to_palette(NordPaletteFile.FROST)
go_nord.add_file_to_palette(NordPaletteFile.AURORA)

go_nord.convert_image(image, save_path=save_path)
