[global]
    monitor = 0
    follow = keyboard
    width = 370
    height = (0,350)
    offset = (0,19)
    padding = 2
    horizontal_padding = 2
    transparency = 25
    font = Iosevka 12
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#434c5e"
    foreground = "#a3be8c"
    border = "#88c0d0"
    timeout = 3

[urgency_normal]
    background = "#434c5e"
    foreground = "#ebcb8b"
    border = "#88c0d0"
    timeout = 5

[urgency_critical]
    background = "#434c5e"
    foreground = "#bf616a"
    frame_color = "#fabd2f"
    border = "#88c0d0"
    timeout = 10
